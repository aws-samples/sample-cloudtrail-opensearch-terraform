# =============================================================================
# Required inputs (only these 3 are needed to deploy!)
# =============================================================================

vpc_id                    = "vpc-0abc123def456789a"
vpc_subnet_ids            = ["subnet-aaaa1111", "subnet-bbbb2222", "subnet-cccc3333"]
cloudtrail_s3_bucket_name = "my-org-bucket"

# =============================================================================
# Optional - Alerting
# =============================================================================

# alert_email_endpoint = "security-team@example.com"

# =============================================================================
# Optional - Access control (map team names to their IAM role ARNs)
# =============================================================================

# team_role_arns = {
#   security_ops        = "arn:aws:iam::123456789012:role/SecurityOpsRole"
#   incident_response   = "arn:aws:iam::123456789012:role/IncidentResponseRole"
#   compliance_auditors = "arn:aws:iam::123456789012:role/ComplianceAuditorsRole"
#   devops              = "arn:aws:iam::123456789012:role/DevOpsRole"
# }

# =============================================================================
# Optional - Override defaults (uncomment to customize)
# =============================================================================

# aws_region              = "us-east-1"
# environment             = "production"
# domain_name             = "cloudtrail-monitoring"
# instance_type           = "or1.2xlarge.search"
# instance_count          = 3
# ebs_volume_size         = 500
# osis_min_units          = 2
# osis_max_units          = 10
# hot_retention_days      = 90
# warm_retention_days     = 365
# cold_retention_days     = 2555
